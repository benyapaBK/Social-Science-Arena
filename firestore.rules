rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomExists(roomId) { return exists(/databases/$(database)/documents/rooms/$(roomId)); }
    function roomData(roomId) { return get(/databases/$(database)/documents/rooms/$(roomId)).data; }
    function isRoomHost(roomId) { return signedIn() && roomExists(roomId) && roomData(roomId).hostUid == request.auth.uid; }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'WAITING'
        && request.resource.data.roomCode == roomId;
      allow update: if isRoomHost(roomId)
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.roomCode == resource.data.roomCode
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentRound', 'updatedAt']);
      allow delete: if isRoomHost(roomId);

      match /players/{uid} {
        allow read: if signedIn() && (isRoomHost(roomId) || request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid && roomExists(roomId)
          && roomData(roomId).status == 'WAITING'
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 24
          && request.resource.data.score == 0
          && request.resource.data.correctCount == 0;
        // Prototype only: score updates are client-side and can be manipulated.
        // For a public/graded competition, move answer validation and score updates to Cloud Functions.
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.name == resource.data.name
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'correctCount'])
          && request.resource.data.score is number
          && request.resource.data.score >= resource.data.score
          && request.resource.data.correctCount is number
          && request.resource.data.correctCount >= resource.data.correctCount;
        allow delete: if isRoomHost(roomId) || (signedIn() && request.auth.uid == uid);
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
