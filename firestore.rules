rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isConfiguredHost() { return signedIn() && request.auth.token.email == 'host123@gmail.com'; }
    function roomExists(roomId) { return exists(/databases/$(database)/documents/rooms/$(roomId)); }
    function roomData(roomId) { return get(/databases/$(database)/documents/rooms/$(roomId)).data; }
    function isRoomHost(roomId) { return signedIn() && roomExists(roomId) && roomData(roomId).hostUid == request.auth.uid; }

    match /appSettings/{settingId} {
      allow read: if signedIn();
      allow create, update: if settingId == 'lobbyBanner' && isConfiguredHost()
        && request.resource.data.keys().hasOnly(['title', 'subtitle', 'image', 'banners', 'updatedAt', 'updatedBy'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 90
        && request.resource.data.subtitle is string && request.resource.data.subtitle.size() <= 220
        && request.resource.data.image is string && request.resource.data.image.size() <= 200000
        && request.resource.data.banners is list && request.resource.data.banners.size() >= 1
        && request.resource.data.banners.size() <= 5
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /users/{uid}/gameHistory/{historyId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['roomCode', 'score', 'correctCount', 'rank', 'finishedAt'])
        && request.resource.data.roomCode is string
        && request.resource.data.score is number && request.resource.data.score >= 0
        && request.resource.data.correctCount is number && request.resource.data.correctCount >= 0
        && request.resource.data.rank is number && request.resource.data.rank >= 1;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'WAITING'
        && request.resource.data.roomCode == roomId;
      allow update: if isRoomHost(roomId)
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.roomCode == resource.data.roomCode
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'currentRound', 'updatedAt', 'questionDurationSeconds',
          'startedAt', 'pausedAt', 'resumedAt'
        ]);
      allow delete: if isRoomHost(roomId);

      match /players/{uid} {
        allow read: if signedIn() && (isRoomHost(roomId) || request.auth.uid == uid || roomData(roomId).status in ['FINISHED', 'CLOSED', 'CANCELLED', 'PLAYING', 'PAUSED', 'WAITING']);
        allow create: if signedIn() && request.auth.uid == uid && roomExists(roomId)
          && roomData(roomId).status == 'WAITING'
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 24
          && request.resource.data.score == 0
          && request.resource.data.correctCount == 0;
        // Prototype limitation: player score fields are still client-writable. For real competitions,
        // move answer validation and score updates into trusted Cloud Functions.
        allow update: if signedIn()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.name == resource.data.name
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'score', 'correctCount', 'currentRound', 'lastRoundScore', 'completed',
            'roundStartedAt', 'lastAnswerAt'
          ])
          && request.resource.data.score is number && request.resource.data.score >= 0
          && request.resource.data.correctCount is number && request.resource.data.correctCount >= 0
          && (request.auth.uid == uid || isRoomHost(roomId));
        allow delete: if isRoomHost(roomId) || (signedIn() && request.auth.uid == uid);
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
