# Firebase Web config is currently defined in src/firebase.ts for project game-puzzle-6767.
# Do not put Firebase Admin SDK credentials or service-account keys in VITE_* variables.
# Trusted server credentials must stay outside the frontend and repository.

# Email of the Firebase Email/Password account used as Host (password = host code, set in Firebase Console).
# Must match the email hard-coded in firestore.rules.
VITE_HOST_EMAIL=host@social-science-arena.app
